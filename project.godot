; Swipe Hunt - minimal Godot 4 prototype

config_version=5

[application]

config/name="Swipe Hunt"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/description="A mobile-first, one-room-at-a-time dark-fantasy chase game."

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=432
window/size/window_height_override=768
window/size/resizable=true
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.035, 0.031, 0.039, 1)
